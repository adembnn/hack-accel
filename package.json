{
  "name": "refuge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "start": "node src/app/serveur.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "e2e:socle": "node --test tests/e2e/socle.test.mjs",
    "test:db": "node scripts/lot-absent.mjs db src/server",
    "test:decideurs": "node --test src/agents/*.test.mts",
    "test:scene": "node scripts/lot-absent.mjs scene src/scene",
    "test:motion": "node scripts/lot-absent.mjs motion src/sim/motion",
    "test:behavior": "node scripts/lot-absent.mjs behavior src/sim/behavior",
    "bench:motion": "node scripts/lot-absent.mjs bench-motion src/sim/motion",
    "bench:avant-apres": "node scripts/lot-absent.mjs bench-avant-apres src/sim/behavior"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
