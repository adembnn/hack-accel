{
  "name": "refuge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "start": "node src/app/serveur.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:lots --silent",
    "build": "vite build",
    "e2e:socle": "node --test tests/e2e/socle.test.mjs",
    "test:db": "node --test src/server/db.test.mjs src/server/securite.test.mjs src/server/vecteur.test.mjs",
    "test:decideurs": "node --test src/agents/*.test.mts",
    "test:scene": "node --test src/scene/*.test.ts",
    "test:motion": "node --test src/sim/motion/motion.test.ts",
    "test:behavior": "node --test \"src/sim/behavior/*.test.ts\" \"src/sim/metrics/*.test.ts\"",
    "bench:motion": "node src/sim/motion/bench.ts",
    "bench:avant-apres": "node bench/avant-apres.ts",
    "demo:integration": "node src/integration/demo.ts",
    "demo:integration-adem": "node src/integration-adem/demo.ts",
    "test:integration-adem": "node --test src/integration-adem/*.test.ts",
    "test:integration": "node --test src/integration/*.test.ts",
    "test:lots": "node --test src/scene/*.test.ts \"src/sim/**/*.test.ts\" src/agents/*.test.mts src/integration/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
